# Server
PORT=39443

# Postgres (matches docker-compose port mapping at the project root)
DATABASE_URL=postgres://pip:pip_dev_password@localhost:54327/pip

# better-auth
# Generate a fresh one: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:39443

# Optional: trusted origins for the auth cookie (comma-separated).
# Add your mobile dev URL, any web frontend host, AND the host you reach the
# server from on a real device — typically http://<your-LAN-IP>:39443.
# Find your IP: `ipconfig getifaddr en0` on macOS or `hostname -I` on Linux.
TRUSTED_ORIGINS=http://localhost:8081,exp://localhost:8081,http://localhost:39443,http://192.168.0.108:39443,pip://app
