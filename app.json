{
  "expo": {
    "name": "Pip",
    "slug": "pip",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pip",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.wvvw.pip"
    },
    "android": {
      "package": "me.wvvw.pip",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6EFE0"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#F6EFE0",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F6EFE0",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a112181c-f9d7-4ad1-92d4-f77ce4200b24"
      }
    },
    "owner": "lucid-softworks"
  }
}
